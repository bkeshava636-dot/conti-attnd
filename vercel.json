{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/ping",
      "destination": "/api/index.js"
    },
    {
      "source": "/fixture",
      "destination": "/api/index.js"
    },
    {
      "source": "/test-fixtures/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/updates.xml",
      "destination": "/api/index.js"
    },
    {
      "source": "/download/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
